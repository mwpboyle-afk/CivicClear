# Google Gemini API key (free tier): https://aistudio.google.com/app/apikey
# Copy this file to .env.local and fill in your key for local development.
# On Vercel, set GEMINI_API_KEY as a project environment variable.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model. Defaults to gemini-3.5-flash.
# If your key gets a 404 "no longer available" error, list the models your key
# can use and set one here:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
# GEMINI_MODEL=gemini-3.5-flash
